{
  "name": "vscode-react-snippet",
  "publisher": "NicholasHsiang",
  "displayName": "React Snippets",
  "description": "Only React 19+",
  "icon": "art/icon.png",
  "version": "19.2.3",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "galleryBanner": {
    "color": "#ffffff",
    "theme": "dark"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xianghongai/vscode-react-snippet/issues"
  },
  "homepage": "https://github.com/xianghongai/vscode-react-snippet/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xianghongai/vscode-react-snippet/blob/master/README.md"
  },
  "engines": {
    "vscode": "^1.0.0",
    "node": ">=24"
  },
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "React",
    "Snippet",
    "React Snippets",
    "React Code Snippets"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/jsx.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/tsx.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/jsx.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/tsx.json"
      }
    ]
  },
  "scripts": {
    "format": "prettier --write --cache .",
    "dev": "nodemon --watch src -e json -x 'pnpm run prebuild'",
    "prebuild": "node main.js",
    "vscode:prepublish": "node main.js",
    "build": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vscode/vsce": "^3.9.2",
    "glob": "^13.0.6",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  }
}